# Expo reads this file at the REPO ROOT only (not back-end/.env).
# After changing, restart Metro: Ctrl+C then `npx expo start --clear`
#
# Phone on THIS PC’s mobile hotspot → use hotspot adapter IP (your ipconfig: 192.168.137.1).
# Phone on same home Wi‑Fi as PC (not hotspot) → use Wi‑Fi IPv4 (yours was 192.168.88.15).
EXPO_PUBLIC_API_BASE_URL=http://192.168.137.1:4000
